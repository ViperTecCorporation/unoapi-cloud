# Obrigatórias
REDIS_URL=redis://:ALTERE_A_SENHA@127.0.0.1:6379
AMQP_URL=amqp://viperconnect:ALTERE_A_SENHA@127.0.0.1:5672
BASE_URL=https://unoapi.seudominio.com.br
UNOAPI_AUTH_TOKEN=ALTERE_ESTE_TOKEN

# Zapo é o padrão; mantidas explícitas para facilitar auditoria operacional.
WHATSAPP_ENGINE=zapo
UNOAPI_WORKER_ENGINE=zapo

# Isola FFmpeg do broker quando as units broker e video forem instaladas.
# Em processo único, ambos continuam no mesmo serviço sem perder mensagens.
UNOAPI_VIDEO_WORKER_MODE=dedicated

# Servidor
PORT=9876
LOG_LEVEL=info
UNO_LOG_LEVEL=info

# Mídia local persistente. Configure STORAGE_* para usar S3/R2/MinIO.
BASE_STORE=/var/lib/viperconnect/data
