{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM"],
    "rootDir": "frontend",
    "outDir": "public/app",
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "removeComments": true
  },
  "include": ["frontend/**/*.ts"]
}
